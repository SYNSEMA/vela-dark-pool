-- embed.syn — puts YOUR program into a released Vela guest module, no compiler involved.
--
--   synsema run embed.syn -- synsema-vela-guest.wasm app.syn build/app.wasm
--
-- The slot's layout and the work live in embed_lib.syn, which the kit's web app uses too.
intent: "embed a .syn program into the app slot of a Vela guest module"

require file.read("*")
require file.write("*")

use "./embed_lib.syn" as slot

let a be args()
when length(a) < 3
    print("usage: synsema run embed.syn -- <synsema-vela-guest.wasm> <app.syn> <out.wasm>")
otherwise
    let wasm be read_file_bytes(a[0])
    let program be read_file(a[1])
    let out be slot.embed(wasm, program, slot.base_name(a[1]))
    write_file(a[2], out)
    print(a[2] + ": " + text(length(out)) + " bytes, program " + slot.base_name(a[1]) + " (" + text(length(bytes(program))) + " bytes), sha256 " + decode(sha256(out), "hex"))

-- ---------------------------------------------------------------------------------------
-- Tests (pure): `synsema test embed.syn`
-- ---------------------------------------------------------------------------------------

task fake_module(program)
    let n be bytes("app.syn")
    let header be bytes("SYNSEMA.APPSLOT1") + bytes([length(n)]) + n + slot.fill(63 - length(n)) + slot.u32_le(length(bytes(program)))
    let padding be slot.fill(524288 - 84 - length(bytes(program)))
    give bytes("\u0000asm\u0001\u0000\u0000\u0000 before ") + header + bytes(program) + padding + bytes(" after")

test "u32 little-endian"
    assert_eq(slot.u32_le(258), bytes([2, 1, 0, 0]))

test "the slot is found and replaced; everything around it is untouched"
    let m be fake_module("task deploy(ctx)\n    give {\"state\": {}}\n")
    let out be slot.embed(m, "task deploy(ctx)\n    give {\"state\": {\"v\": 2}}\n", "other.syn")
    assert_eq(length(out), length(m))
    assert_eq(slice(out, length(out) - 6, length(out)), bytes(" after"))
    let off be slot.slot_offset(out)
    assert_eq(decode(slice(out, off + 17, off + 26)), "other.syn")

test "no slot, two slots, or a program that does not fit are clear errors"
    assert_error(() => slot.slot_offset(bytes("no slot here")))
    let m be fake_module("x")
    assert_error(() => slot.slot_offset(m + m))
    assert_error(() => slot.embed(m, decode(int_to_bytes(0, 524288), "hex"), "big.syn"))

test "embed writes byte for byte what build.rs writes for the same program (the filler is 0x20)"
    assert_eq(slot.fill(3), bytes([32, 32, 32]))
    let other be "-- another program; the 0x20 filler follows it"
    assert_eq(slot.embed(fake_module("x"), other, "app.syn"), fake_module(other))
