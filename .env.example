# The auction console (web.syn, run from this folder). On the Synsema platform the provision fills all
# of this at creation; locally, `cd client && synsema run vela_client.syn -- devnet` writes the same
# lines for the CLI, and copying them here serves the console.
VELA_RPC_URL=https://devnet.synsema.app/<token>/rpc
VELA_AUTHORITY_URL=https://devnet.synsema.app/<token>/authority
VELA_SUBGRAPH_URL=https://devnet.synsema.app/<token>/subgraph/subgraphs/name/hcce
VELA_PROCESSOR=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9
VELA_TEE_AUTHENTICATOR=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
VELA_TOKEN=
VELA_MAX_FEE=100
# the seller's signing key (on the devnet, the account that came with your token; its wallet funds the demo bidders); the P-521 pair is made by the console when empty
VELA_SECP_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# the public devnet's admin desk for your token (it signs allow-token / allow-authority), written by `devnet`; empty on a local kit
VELA_ADMIN_URL=
# the admin key when the kit signs the allowlists itself (a devnet of your own); empty otherwise
VELA_ADMIN_KEY=
VELA_P521_KEY=
VELA_P521_PUB=
# the console listens on 127.0.0.1; to reach it from elsewhere set CONSOLE_BIND=0.0.0.0 and a password
CONSOLE_BIND=
CONSOLE_PASSWORD=
